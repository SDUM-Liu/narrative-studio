# Export these in the shell/process manager that starts the API worker.
# No automatic .env loading. Never commit real credentials.
MINIMAX_API_KEY=
ARK_API_KEY=
# Alternatively use a chmod 600 plaintext secret file (explicit path).
MINIMAX_API_KEY_FILE=
ARK_API_KEY_FILE=
# MiniMax key region: global (api.minimax.io) or cn (api.minimax.cn).
MINIMAX_API_REGION=
